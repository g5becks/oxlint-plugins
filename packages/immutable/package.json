{
  "name": "oxlint-plugin-immutable",
  "version": "0.3.0",
  "type": "module",
  "description": "Immutability lint rules ported from eslint-plugin-functional to Oxlint's JS plugin API. Also compatible with ESLint flat config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/oxlint-plugins.git",
    "directory": "packages/immutable"
  },
  "homepage": "https://github.com/g5becks/oxlint-plugins/tree/main/packages/immutable#readme",
  "bugs": {
    "url": "https://github.com/g5becks/oxlint-plugins/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "oxlint",
    "eslint",
    "functional",
    "immutability",
    "readonly",
    "lint"
  ],
  "peerDependencies": {
    "oxlint": ">=1.70.0 <2",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
