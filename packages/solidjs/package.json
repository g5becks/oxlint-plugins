{
  "name": "oxlint-plugin-solidjs",
  "version": "0.1.1",
  "type": "module",
  "description": "SolidJS lint rules ported from eslint-plugin-solid to Oxlint's JS plugin API. Also compatible with ESLint flat config. Published as oxlint-plugin-solidjs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/oxlint-plugins.git",
    "directory": "packages/solidjs"
  },
  "homepage": "https://github.com/g5becks/oxlint-plugins/tree/main/packages/solidjs#readme",
  "bugs": {
    "url": "https://github.com/g5becks/oxlint-plugins/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "oxlint",
    "eslint",
    "solid",
    "solidjs",
    "solid-js",
    "jsx",
    "reactivity",
    "lint"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
