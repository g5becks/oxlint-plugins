{
  "name": "oxlint-plugin-errorset",
  "version": "0.2.1",
  "type": "module",
  "description": "Oxlint plugin that enforces correct usage of @takinprofit/errorset. Catches throws, catch-block misuse, and unguarded data access.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/oxlint-plugins.git",
    "directory": "packages/errorset"
  },
  "homepage": "https://github.com/g5becks/oxlint-plugins/tree/main/packages/errorset#readme",
  "bugs": {
    "url": "https://github.com/g5becks/oxlint-plugins/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "oxlint",
    "eslint",
    "errorset",
    "error-handling",
    "lint"
  ],
  "peerDependencies": {
    "oxlint": ">=1.70.0 <2",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
