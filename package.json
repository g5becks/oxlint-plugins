{
  "name": "oxlint-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun scripts/build.ts",
    "test": "bun run test:unit && bun run test:compat && bun run test:cli",
    "test:unit": "node --test \"packages/*/tests/*.test.ts\"",
    "test:compat": "bun test ./tests/integration/*.test.ts ./tests/eslint-compat/*.test.ts",
    "test:cli": "bun test ./tests/cli/*.cli.test.ts",
    "test:bench": "bun test ./tests/bench/*.test.ts",
    "check": "node node_modules/typescript-7/bin/tsc -b --pretty false",
    "lint": "oxlint --deny-warnings packages scripts tests && bun scripts/check-createonce-state.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:repo": "bun test ./tests/repo/*.test.ts",
    "test:pack": "bun scripts/pack-smoke.ts",
    "gate": "bun run lint && bun run format:check && bun run check && bun run build && bun run test:unit && bun run test:compat && bun run test:repo && bun run test:cli && bun run test:bench",
    "release:prepare": "bun scripts/release-prepare.ts",
    "test:unit:errorset": "node --test \"packages/errorset/tests/*.test.ts\"",
    "test:unit:immutable": "node --test \"packages/immutable/tests/*.test.ts\"",
    "test:unit:ts-no-assert": "node --test \"packages/ts-no-assert/tests/*.test.ts\"",
    "test:unit:query": "node --test \"packages/query/tests/*.test.ts\"",
    "test:unit:router": "node --test \"packages/router/tests/*.test.ts\"",
    "test:unit:solidjs": "node --test \"packages/solidjs/tests/*.test.ts\"",
    "lint:state": "bun scripts/check-createonce-state.ts",
    "test:compat:eslint10": "ESLINT_PACKAGE=eslint-10 bun test ./tests/integration/*.test.ts ./tests/eslint-compat/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@oxlint/plugins": "1.93.0",
    "@takinprofit/errorset": "0.5.0",
    "@types/bun": "1.4.4",
    "@typescript-eslint/parser": "8.72.2",
    "backlog.md": "1.55.3",
    "eslint": "9.39.5",
    "eslint-10": "npm:eslint@10.14.0",
    "lefthook": "2.2.2",
    "oxlint": "1.93.0",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "version": ""
}
